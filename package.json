{
  "name": "autodidact",
  "version": "0.0.0",
  "description": "An open-source, self-hosted course reader for personal learning.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kode-blox/autodidact.git"
  },
  "homepage": "https://autodidact.kodeblox.com",
  "bugs": {
    "url": "https://github.com/kode-blox/autodidact/issues"
  },
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "types:check": "next typegen && tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx --test tests/integration/*.test.ts",
    "lint": "eslint",
    "worker:check": "npm run check --workspace=@kode-blox/autodidact-sign-in-router",
    "worker:deploy": "npm run deploy --workspace=@kode-blox/autodidact-sign-in-router"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@opentelemetry/exporter-prometheus": "0.301.2",
    "@opentelemetry/sdk-metrics": "3.1.1",
    "cn": "^0.5.2",
    "d3": "^7.9.2",
    "fumadocs-core": "16.18.4",
    "fumadocs-mdx": "15.5.3",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.18.4",
    "hast-util-from-html": "^2.1.0",
    "katex": "^0.16.47",
    "lucide-react": "^1.70.0",
    "mermaid": "^12.3.0",
    "next": "16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-math": "^6.0.0",
    "unist-util-visit": "^5.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/d3": "^7.4.3",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "^10.1.8",
    "postcss": "^8.5.32",
    "prettier": "3.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "workspaces": [
    "docs",
    "workers/**"
  ]
}
