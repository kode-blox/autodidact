{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "autodidact-dev-signin",
  "main": "src/index.js",
  "compatibility_date": "2026-11-21",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "PUBLIC_HOST": "learn-dev.sayakm.me",
    "AUTH_SIGN_IN_URL": "https://auth.sayakm.me/oauth2/sign_in"
  },
  "routes": [
    {
      "pattern": "learn-dev.sayakm.me/*",
      "zone_name": "sayakm.me"
    }
  ]
}
