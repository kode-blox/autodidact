# Copy to .env and configure an existing private, unversioned S3 bucket.
# Example Hetzner endpoint and matching region; leave endpoint empty for AWS S3.
S3_ENDPOINT=https://fsn1.your-objectstorage.com
S3_REGION=fsn1
S3_BUCKET=replace-with-your-bucket-name
S3_PREFIX=autodidact/
# Optional override; custom endpoints default to path-style addressing.
S3_FORCE_PATH_STYLE=
# Server-only credentials. An SDK-supported workload role may be used instead.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Browser-facing origin; change this when placing an authenticated HTTPS gateway in front.
APP_ORIGIN=http://127.0.0.1:8080
